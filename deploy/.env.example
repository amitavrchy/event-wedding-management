# Utsab runtime environment -> copy to /opt/apps/utsab/.env on the server (chmod 600).
# Shared by the backend and frontend containers (docker compose env_file).
# PORT / NODE_ENV / NODE_OPTIONS / HOSTNAME are set by docker-compose.yml; don't set them here.

# ---------- Backend (required) ----------
# Postgres on the shared container (external Docker network apps-net). Database + user: utsab.
DATABASE_URL=postgresql://utsab:CHANGE_ME_DB_PASSWORD@shared-postgres:5432/utsab
# JWT signing secret, >= 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
# HMAC secret for the payment webhook endpoint (separate from JWT_SECRET). Generate: openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
# Comma-separated browser origins allowed by CORS and Socket.IO.
CORS_ORIGINS=https://utsab.13.203.3.1.sslip.io
# Payments are disabled in production. "sandbox" only works when NODE_ENV is not production.
PAYMENT_MODE=disabled
# Trust X-Forwarded-For from Nginx and the Next.js /api proxy so rate limiting sees real client IPs.
TRUST_PROXY=loopback,linklocal,uniquelocal

# ---------- Backend (optional) ----------
# Redis is provided by the compose file (utsab-redis) and wired into backend + worker automatically.
# Public frontend URL, used in emails, SMS, invitation links and password reset links.
APP_URL=https://utsab.13.203.3.1.sslip.io

# ---------- Notifications ----------
# Production refuses the console drivers. Configure real providers:
EMAIL_DRIVER=smtp
SMTP_URL=smtps://CHANGE_ME_USER:CHANGE_ME_PASSWORD@smtp.example.com:465
EMAIL_FROM="Ayojon <no-reply@example.com>"
SMS_DRIVER=http
SMS_API_URL=https://bulksms.example.com/api/smsapi
SMS_API_KEY=CHANGE_ME
SMS_SENDER_ID=CHANGE_ME
PUSH_DRIVER=fcm
# base64 of the Firebase service-account JSON: base64 -w0 service-account.json
FCM_SERVICE_ACCOUNT=CHANGE_ME

# ---------- File storage (S3 / Cloudflare R2 / MinIO) ----------
STORAGE_DRIVER=s3
S3_BUCKET=CHANGE_ME
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Public CDN/base URL for public objects (portfolio images, covers)
S3_PUBLIC_URL=https://cdn.example.com

# Separate key for encrypting two-factor secrets. Generate: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ---------- Frontend ----------
# Build-time only (baked into the image by the deploy workflow; listed here for reference, changing them here has no effect):
#   API_URL=http://utsab-backend:4003                       # /api/* rewrite target (internal Docker network)
#   NEXT_PUBLIC_SOCKET_URL=https://api.utsab.13.203.3.1.sslip.io   # browser Socket.IO endpoint

# ---------- Backups (deploy/scripts/backup.sh) ----------
# Passphrase for encrypting database dumps. Keep a copy outside the server (password manager).
BACKUP_PASSPHRASE=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
# Optional off-host copy (S3/R2/MinIO), e.g. s3://my-bucket/utsab-backups. Empty keeps backups on the host only.
BACKUP_S3_URI=
BACKUP_KEEP_DAYS=14
