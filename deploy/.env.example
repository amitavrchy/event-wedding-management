# Utsab runtime environment -> copy to /opt/apps/utsab/.env on the server (chmod 600).
# Shared by the backend and frontend containers (docker compose env_file).
# PORT / NODE_ENV / NODE_OPTIONS / HOSTNAME are set by docker-compose.yml; don't set them here.

# ---------- Backend (required) ----------
# Postgres on the shared container (external Docker network apps-net). Database + user: utsab.
DATABASE_URL=postgresql://utsab:CHANGE_ME_DB_PASSWORD@shared-postgres:5432/utsab
# JWT signing secret, >= 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
# HMAC secret for the payment webhook endpoint (separate from JWT_SECRET). Generate: openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
# Comma-separated browser origins allowed by CORS and Socket.IO.
CORS_ORIGINS=https://utsab.13.203.3.1.sslip.io
# "sandbox" enables the built-in sandbox payment provider (no real money). Any other value disables payments.
PAYMENT_MODE=sandbox
# Trust X-Forwarded-For from Nginx and the Next.js /api proxy so rate limiting sees real client IPs.
TRUST_PROXY=loopback,linklocal,uniquelocal

# ---------- Backend (optional) ----------
# Redis for the BullMQ maintenance worker (expires holds/quotes, creates reminders, runs automations every minute).
# Leave empty to disable background jobs (the API still runs). Example: redis://some-redis:6379
REDIS_URL=
# Public frontend URL (documented by the project; currently not read by the API code).
APP_URL=https://utsab.13.203.3.1.sslip.io

# ---------- Frontend ----------
# Build-time only (baked into the image by the deploy workflow; listed here for reference, changing them here has no effect):
#   API_URL=http://utsab-backend:4003                       # /api/* rewrite target (internal Docker network)
#   NEXT_PUBLIC_SOCKET_URL=https://api.utsab.13.203.3.1.sslip.io   # browser Socket.IO endpoint
