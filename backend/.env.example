DATABASE_URL=postgresql://utsab:local-development-only@localhost:5544/utsab
REDIS_URL=redis://localhost:6388
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
PORT=4000
PAYMENT_MODE=sandbox
WEBHOOK_SECRET=replace-with-a-separate-random-secret
# Leave REDIS_URL empty to run without background jobs; notifications are then delivered in-process.
# RUN_WORKER=false makes this process enqueue only (production runs a separate worker container).

# ---------- Notifications (console drivers print to the log in development) ----------
EMAIL_DRIVER=console
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM="Ayojon <no-reply@example.com>"
SMS_DRIVER=console
# SMS_API_URL=https://bulksms.example.com/api/smsapi
# SMS_API_KEY=
# SMS_SENDER_ID=
PUSH_DRIVER=console
# FCM_SERVICE_ACCOUNT=<base64 of the Firebase service-account JSON>

# ---------- File storage ----------
# local stores files under ./uploads (development only). Use s3 for S3, Cloudflare R2 or MinIO.
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.example.com
# S3_FORCE_PATH_STYLE=true   # MinIO

# ---------- Security ----------
# Separate key for encrypting two-factor secrets (defaults to JWT_SECRET).
# TOTP_ENCRYPTION_KEY=
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_PER_MINUTE=180
