generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  fullName String
  passwordHash String
  role String @default("HOST")
  createdAt DateTime @default(now())
}
model Vendor {
  id String @id @default(cuid())
  ownerId String
  slug String @unique
  businessName String
  category String
  city String @default("Dhaka")
  description String
  image String
  status String @default("APPLIED")
  commissionBps Int @default(1000)
  services VendorService[]
  members VendorMember[]
}
model VendorService {
  id String @id @default(cuid())
  vendorId String
  vendor Vendor @relation(fields: [vendorId], references: [id])
  title String
  basePriceMinor Int
  durationHours Int @default(4)
  bufferHours Int @default(1)
  capacity Int?
  bookings Booking[]
  blocks AvailabilityBlock[]
}
model AvailabilityBlock {
  id String @id @default(cuid())
  serviceId String
  service VendorService @relation(fields: [serviceId], references: [id])
  startAt DateTime
  endAt DateTime
  reason String?
}
model Event {
  id String @id @default(cuid())
  hostId String
  title String
  eventType String @default("GENERAL")
  city String @default("Dhaka")
  status String @default("PLANNING")
  budgetMinor Int @default(150000000)
  guestCapacity Int @default(300)
  rsvpDeadline DateTime?
  createdAt DateTime @default(now())
  days EventDay[]
  tasks ChecklistItem[]
  budget BudgetItem[]
  expenses Expense[]
  guests Guest[]
  bookings Booking[]
  members EventMember[]
}
model EventDay {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields:[eventId],references:[id])
  name String
  startsAt DateTime
  endsAt DateTime
  venueName String?
}
model ChecklistItem {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields:[eventId],references:[id])
  title String
  done Boolean @default(false)
  dueAt DateTime?
}
model Booking {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields:[eventId],references:[id])
  serviceId String
  service VendorService @relation(fields:[serviceId],references:[id])
  vendorId String
  status String @default("HELD")
  startAt DateTime
  endAt DateTime
  reservedUntil DateTime
  holdExpiresAt DateTime
  priceMinor Int
  advanceMinor Int
  category String
  quoteId String? @unique
  policyFlags String[] @default([])
  createdAt DateTime @default(now())
  @@index([serviceId,startAt,reservedUntil])
}
model BudgetItem {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields:[eventId],references:[id])
  category String
  plannedMinor Int
  @@unique([eventId,category])
}
model Expense {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields:[eventId],references:[id])
  category String
  amountMinor Int
  note String
  createdAt DateTime @default(now())
}
model Guest {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields:[eventId],references:[id])
  name String
  email String?
  phone String?
  partySize Int @default(1)
  maxPartySize Int @default(2)
  rsvpStatus String @default("INVITED")
  token String @unique
  mealPreference String?
  tableLabel String?
  seatingTableId String?
  groupName String @default("Friends")
  dietaryNotes String?
}
model Package {
  id String @id @default(cuid())
  vendorId String?
  title String
  description String
  serviceIds String[]
  discountBps Int @default(500)
}
model Quote {
  id String @id @default(cuid())
  eventId String
  vendorId String
  status String @default("SENT")
  amountMinor Int
  breakdown Json
  expiresAt DateTime
}
model Payment {
  id String @id @default(cuid())
  bookingId String
  eventId String
  provider String
  status String @default("PENDING")
  amountMinor Int
  kind String
  installmentId String?
  idempotencyKey String @unique
  createdAt DateTime @default(now())
}
model LedgerEntry {
  id String @id @default(cuid())
  paymentId String @unique
  vendorId String
  grossMinor Int
  commissionMinor Int
  netMinor Int
  status String @default("PENDING")
  createdAt DateTime @default(now())
}
model Review {
  id String @id @default(cuid())
  bookingId String @unique
  vendorId String
  hostId String
  rating Int
  body String
  createdAt DateTime @default(now())
}
model Conversation {
  id String @id @default(cuid())
  eventId String
  vendorId String
  messages Message[]
  @@unique([eventId,vendorId])
}
model Message {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields:[conversationId],references:[id])
  senderId String
  body String
  createdAt DateTime @default(now())
}
model Notification {
  id String @id @default(cuid())
  key String @unique
  recipientId String
  title String
  body String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([recipientId,createdAt])
}
model Dispute {
  id String @id @default(cuid())
  bookingId String @unique
  eventId String
  reason String
  status String @default("REQUESTED")
  createdAt DateTime @default(now())
}
model EventMember {
 id String @id @default(cuid())
 eventId String
 event Event @relation(fields:[eventId],references:[id],onDelete:Cascade)
 userId String
 permission String @default("EDITOR")
 expiresAt DateTime
 @@unique([eventId,userId])
}
model VendorMember {
 id String @id @default(cuid())
 vendorId String
 vendor Vendor @relation(fields:[vendorId],references:[id],onDelete:Cascade)
 userId String
 permission String @default("MANAGER")
 expiresAt DateTime
 @@unique([vendorId,userId])
}
model WorkspaceInvite {
 id String @id @default(cuid())
 token String @unique
 scope String
 scopeId String
 email String
 permission String
 expiresAt DateTime
 memberExpiresAt DateTime
 acceptedBy String?
 createdAt DateTime @default(now())
}
model SeatTable {
 id String @id @default(cuid())
 eventId String
 label String
 capacity Int @default(8)
 shape String @default("ROUND")
 x Float @default(100)
 y Float @default(100)
 version Int @default(1)
 @@unique([eventId,label])
}
model RunSheetItem {
 id String @id @default(cuid())
 eventId String
 dayId String
 title String
 startsAt DateTime
 durationMinutes Int
 owner String
 location String?
 notes String?
 status String @default("PLANNED")
 version Int @default(1)
 @@index([eventId,startsAt])
}
model Contract {
 id String @id @default(cuid())
 eventId String
 vendorId String
 title String
 body String
 amountMinor Int
 contentHash String
 status String @default("SENT")
 signedBy String?
 signerName String?
 signedAt DateTime?
 createdAt DateTime @default(now())
}
model Installment {
 id String @id @default(cuid())
 bookingId String
 eventId String
 label String
 amountMinor Int
 dueAt DateTime
 status String @default("PENDING")
 @@index([eventId,dueAt])
}
model Lead {
 id String @id @default(cuid())
 vendorId String
 name String
 email String?
 eventDate DateTime?
 estimatedMinor Int @default(0)
 stage String @default("NEW")
 notes String @default("")
 followUpAt DateTime?
 createdAt DateTime @default(now())
 @@index([vendorId,stage])
}
model AutomationRule {
 id String @id @default(cuid())
 eventId String
 title String
 trigger String
 daysBefore Int @default(7)
 action String
 message String
 enabled Boolean @default(true)
 createdBy String
 createdAt DateTime @default(now())
}
model AutomationRun {
 id String @id @default(cuid())
 key String @unique
 ruleId String
 eventId String
 result String
 createdAt DateTime @default(now())
}
model EventWebsite {
 id String @id @default(cuid())
 eventId String @unique
 slug String @unique
 headline String
 story String @default("")
 coverUrl String
 theme String @default("ROSE")
 faqs Json
 passwordHash String?
 published Boolean @default(false)
 version Int @default(1)
 updatedAt DateTime @updatedAt
}
model GuestbookEntry {
 id String @id @default(cuid())
 websiteId String
 name String
 message String
 approved Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([websiteId,approved])
}
model MoodItem {
 id String @id @default(cuid())
 eventId String
 kind String
 title String
 value String
 tag String @default("Inspiration")
 createdAt DateTime @default(now())
}
model Favorite {
 id String @id @default(cuid())
 userId String
 vendorId String
 @@unique([userId,vendorId])
}
model Activity {
 id String @id @default(cuid())
 eventId String?
 vendorId String?
 actorId String
 actorName String
 action String
 detail String
 createdAt DateTime @default(now())
 @@index([eventId,createdAt])
 @@index([vendorId,createdAt])
}
model GuestCheckin {
 id String @id @default(cuid())
 eventId String
 dayId String
 guestId String
 partySize Int
 checkedInBy String
 createdAt DateTime @default(now())
 @@unique([dayId,guestId])
}
model GuestResponse {
 id String @id @default(cuid())
 guestId String
 dayId String
 status String
 @@unique([guestId,dayId])
}
model Category {
 id String @id @default(cuid())
 name String @unique
 enabled Boolean @default(true)
}
